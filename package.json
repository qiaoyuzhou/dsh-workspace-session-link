{
  "name": "dsh-workspace-session-link",
  "version": "0.1.0",
  "description": "从 DSH 输入框链接当前工作区内的其他会话，让模型带着跨会话上下文完成任务",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/smoke.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "workspace",
    "reference"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-session-reference"
      ]
    }
  },
  "license": "MIT"
}
